{
  "name": "@mambalabsdev/mcp-google-trends-scraper",
  "version": "1.0.1",
  "description": "MCP server for Google Trends Scraper. Interest over time, regions, metros, and related queries per search term, with up to 5 terms compared. No Google login or key. Runs on Apify. Clay-ready output.",
  "type": "module",
  "bin": {
    "mcp-google-trends-scraper": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-trends",
    "trends",
    "keyword-research",
    "seo",
    "market-research",
    "apify",
    "clay"
  ],
  "author": "Mamba Labs <labs@mambamindsetgrowth.com>",
  "license": "MIT",
  "homepage": "https://apify.com/mambalabs/google-trends-scraper",
  "repository": {
    "type": "git",
    "url": "https://github.com/mambalabsdev/mcp-google-trends-scraper"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.9.3"
  },
  "mcpName": "com.mambabuilt/mcp-google-trends-scraper"
